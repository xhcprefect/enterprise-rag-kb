# ===== 应用 =====
# 测试/离线环境可在启动进程前设置环境变量 RAG_DISABLE_DOTENV=1，
# 让 Settings 完全不读取本文件；正常运行时无需设置、行为不变。
APP_NAME=Enterprise RAG Knowledge Base
# 接口文档开关：true 才注册 /docs、/redoc、/openapi.json。
# 生产保持 false——/openapi.json 会把全部接口与字段结构公开出去。
DEBUG=false
API_V1_PREFIX=/api/v1
# 本地开发保持 development；Compose 会强制覆盖为 production 并校验 JWT 密钥。
ENVIRONMENT=development
# 每个 API 进程的问答准入上限，超出立即返回 429，不挤占全部线程。
CHAT_MAX_PER_USER=2
CHAT_MAX_CONCURRENT=50
# 同一会话的持久化生成租约；异步轮询定期续期，进程崩溃后到期允许新请求。
CHAT_LEASE_SECONDS=300
# 同步 ORM、检索和上传的线程池；主问答的模型流是原生异步，不为等待 token 占线程。
# 此值不是模型并发上限，仍需结合模型额度、数据库连接池和当前版本压测设置。
THREAD_POOL_SIZE=200

# ===== 流式生命周期（秒；修改后重启 API） =====
# 心跳不延长首字/正文停顿/整轮截止时间；浏览器使用 meta 下发的限制独立计时。
CHAT_STREAM_HEARTBEAT_SECONDS=10
CHAT_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=60
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=45
CHAT_STREAM_TOTAL_TIMEOUT_SECONDS=300
# 慢客户端单次发送上限，避免无限背压占着上游与问答名额。
CHAT_STREAM_SEND_TIMEOUT_SECONDS=15
# 同进程取消立即通知；跨进程通过数据库检查取消与续期。
CHAT_STREAM_CANCEL_POLL_SECONDS=1
CHAT_STREAM_MAX_FRAME_BYTES=65536
CHAT_STREAM_MAX_ANSWER_CHARS=131072
# 正文结束后最多等待尾部实际用量的时间；没有用量保留未知，不补零。
LLM_STREAM_USAGE_GRACE_SECONDS=0.5
# 每个 API 进程共享异步 HTTP 连接池的上限（模型流）。
LLM_ASYNC_MAX_CONNECTIONS=64

# ===== 数据库 (pgvector, 容器映射到宿主 9999) =====
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:9999/ragdb

# ===== 认证 =====
# 生产环境务必替换为随机长字符串: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 首次启动自动创建的管理员账号。
# ADMIN_PASSWORD 只在库里还没有这个用户时被读取一次：建号之后改这里不会改密码，
# 改密码请登录后走「个人中心」。管理员已存在时该值若与真实密码不符，
# 启动日志会告警提醒删除这一行——线上环境建议建号后就把密码从文件里删掉。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ===== 模型服务 =====
# EMBEDDING_PROVIDER / LLM_PROVIDER：ollama（本地） 或 cloud（任意 OpenAI 兼容服务）
# 两者互相独立，可以用 A 家的向量模型配 B 家的对话模型。
# API Key 只填在本地 .env，不要提交到仓库。
EMBEDDING_PROVIDER=cloud
LLM_PROVIDER=cloud

# --- 本地 Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- 向量服务（OpenAI 兼容）---
# 硅基流动 BAAI/bge-m3 当前免费，Key 在 https://cloud.siliconflow.cn/account/ak 获取
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=120
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MODEL=BAAI/bge-m3

# --- 对话服务（OpenAI 兼容）---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT=180
# 请求流末尾的实际 token 用量，用于用量/费用统计；不支持 stream_options 的网关可关闭。
LLM_STREAM_INCLUDE_USAGE=true
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
# DeepSeek 官方接口：none 关闭模型端思考；low / high / max 开启思考并设置强度。
# 主问答、普通对话、非流式调用及追问补全统一生效。修改后须重启 API。
# 切换到不支持 reasoning_effort 的兼容服务时留空，否则可能返回 400。
LLM_REASONING_EFFORT=none
# 必须不大于所接模型实际支持的窗口；总输入会预留最大输出和安全余量。
# 输入按 UTF-8 字节保守估算，不是模型 tokenizer 的精确 token 数。
# Ollama 同步使用此值作为 num_ctx，调大前检查内存/显存容量。
LLM_CONTEXT_WINDOW_TOKENS=32768
CONTEXT_TOKEN_SAFETY_MARGIN=512

# 云端 BAAI/bge-m3 与本地 bge-m3:latest 是同一份权重、同一向量空间，
# 两者的向量可以混用，切换服务商时不需要重建索引。

# ===== RAG 参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 检索条数默认值：问答页滑块的初值取自它；调用方未显式指定 top_k 时也用它。
# 改这里就对问答页生效，不需要改前端。
RETRIEVAL_TOP_K=6
# 0 保持原有召回范围；请基于问题集评测后再提高相似度阈值（0~1）。
RETRIEVAL_MIN_SIMILARITY=0
# 单份文档最多占几条检索结果：长文档的分块彼此相似，不封顶会挤掉其他来源
RETRIEVAL_MAX_PER_DOC=3
# 向量 + PostgreSQL 关键词候选，旧文档重新索引后填充关键词和结构位置。
HYBRID_RETRIEVAL_ENABLED=true
KEYWORD_CANDIDATES=60
# 仅扩展同章节/同工作表的相邻片段；0 关闭，最终仍受统一上下文预算限制。
RETRIEVAL_NEIGHBOR_CHUNKS=1
# 可选外部重排：默认不调用，不新增服务；需支持 POST /rerank。
RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=3
RERANK_MAX_CHARS=2000
MAX_UPLOAD_MB=50

# ===== 多轮上下文 =====
# 仅知识库模式中的常见指代/省略追问额外调用一次模型；独立问题、换话题和普通对话跳过。
# 单次总截止时间（秒），失败/超时回退原问题检索，不重试。
RETRIEVAL_REWRITE_ENABLED=true
RETRIEVAL_REWRITE_TIMEOUT=5
RETRIEVAL_REWRITE_MAX_TOKENS=256
RETRIEVAL_REWRITE_HISTORY_TURNS=3
RETRIEVAL_REWRITE_HISTORY_CHARS=3000
# 最多保留多少个完整 user + assistant 轮次；0 禁用历史。
HISTORY_MAX_TURNS=10
# 历史总字符上限，另受统一输入预算约束；最新一轮过长时成对截短。
HISTORY_MAX_CHARS=8000

# ===== 分片上传 / 断点续传 =====
# 生产走容器时由 compose 覆盖为 /data/uploads（绝对路径）。
# 注意 stored_path 会以相对路径存进数据库，API 与 worker 的工作目录和挂载必须一致。
UPLOAD_DIR=storage/uploads
UPLOAD_CHUNK_SIZE=4194304        # 4MB/片，由服务端下发
UPLOAD_SESSION_TTL_HOURS=24      # 未完成会话保留时长

# ===== 入库任务 =====
INGEST_BATCH_SIZE=8              # 每批向量化的分块数
INGEST_STALE_SECONDS=300         # 心跳超时判定
CHUNK_PERSIST_BATCH=500          # 分块落库批大小

# ===== 普通对话摘要压缩 =====
# 默认关闭：false 时完全回到现有窗口裁剪，不新增任何后台模型调用。
# 开启后由独立 ``--role summary`` worker 消费摘要任务；Compose 用 profile 启动：
#   docker compose --profile summary up -d worker-summary
# 只开 CHAT_MEMORY_ENABLED 而不启动该容器时，摘要任务会一直停留在 queued。
CHAT_MEMORY_ENABLED=false
# 已发布摘要 + 未覆盖完整轮次可占用的输入 token 预算；不得超过可用输入预算
#（LLM_CONTEXT_WINDOW_TOKENS - LLM_MAX_OUTPUT_TOKENS - CONTEXT_TOKEN_SAFETY_MARGIN）。
MEMORY_HISTORY_TOKEN_BUDGET=8000
# 达到该比例，或未归档完整轮次数达到阈值，即入队摘要。
MEMORY_TRIGGER_RATIO=0.75
MEMORY_TRIGGER_TURNS=8
# 摘要后保留的最近完整轮次原文。
MEMORY_KEEP_RECENT_TURNS=4
# 单次摘要输出 token 上限与单次调用超时（秒）。
MEMORY_SUMMARY_MAX_TOKENS=1200
MEMORY_SUMMARY_TIMEOUT_SECONDS=60
# 失败有限退避：最大尝试次数；摘要任务租约与轮询间隔（秒）。
MEMORY_MAX_ATTEMPTS=3
MEMORY_JOB_LEASE_SECONDS=300
MEMORY_POLL_SECONDS=2
# 单次摘要输入最多纳入的完整轮次数（硬界）。
MEMORY_MAX_INPUT_TURNS=200

# ===== 本地项目文档/源码索引 =====
# 授权根目录映射 {root_key: 绝对路径}；默认空 = 不创建任何项目源。
# 请只填写你确实要索引的目录；示例关闭默认，绝不写入本机真实授权目录。
# 值必须是**服务进程能看到**的路径：
#   - 本地开发：宿主机绝对路径；
#   - Compose：容器内路径（默认没有任何宿主机目录被挂进 worker-project，
#     需要管理员显式只读绑定，见根目录 .env.example 的 PROJECT_ROOT_HOST 说明）。
PROJECT_ALLOWED_ROOTS={}
# 受控 blob/快照存储目录（系统拥有），不以源路径当作打开句柄。
# Compose 会覆盖为 /data/projects，并挂到宿主机 ${DATA_DIR}/projects；
# API 与 project worker 必须指向同一个持久目录，否则引用读不到原文。
PROJECT_STORAGE_DIR=storage/projects
# 项目同步由独立 ``--role project`` worker 消费；Compose 用 profile 启动：
#   docker compose --profile project up -d worker-project
# 未启动时同步任务停留在 pending。PROJECT_ALLOWED_ROOTS 为空时不需要启动。
# 单次同步硬界：最大文件数 / 单文件字节 / 总字节。
PROJECT_MAX_FILES=5000
PROJECT_MAX_FILE_BYTES=4194304
PROJECT_MAX_TOTAL_BYTES=536870912
# 解析批大小与 embedding 单次请求超时（秒）。
PROJECT_PARSE_BATCH=8
PROJECT_EMBEDDING_TIMEOUT_SECONDS=120
# 项目同步任务租约 / 轮询 / stale 判定 / 失败重试上限。
PROJECT_JOB_LEASE_SECONDS=300
PROJECT_POLL_SECONDS=2
PROJECT_STALE_SECONDS=300
PROJECT_MAX_ATTEMPTS=3
# 项目 KB 的向量 collection 前缀（同一源/配置共享，跨配置不误复用）。
PROJECT_VECTOR_PREFIX=proj_

# ===== 反馈回归在线作业 =====
# 管理员显式提交的在线回归作业由独立 ``--role regression`` worker 消费；
# 未启动该进程时作业一直停留在 queued，不会在 API/其他角色进程里偷偷调用模型。
#   docker compose --profile regression up -d worker-regression
# 租约（秒）：worker 生成期间按观察周期续租；进程崩溃后到期由 recover 回收。
FEEDBACK_REGRESSION_JOB_LEASE_SECONDS=300
# 空闲轮询间隔（秒）：只查数据库队列，不产生模型调用。
FEEDBACK_REGRESSION_JOB_POLL_SECONDS=2
# 单作业有界尝试次数（含首次）；仅显式可恢复错误才自动重排队。
FEEDBACK_REGRESSION_JOB_MAX_ATTEMPTS=3
# 可恢复失败的重排队延迟（秒）。
FEEDBACK_REGRESSION_JOB_RETRY_DELAY_SECONDS=5
# 整个作业（含全部重放问题与重试）的总期限（秒）；heartbeat 不延长该期限。
FEEDBACK_REGRESSION_JOB_TOTAL_TIMEOUT_SECONDS=600

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=logs                     # 生产由 compose 覆盖为 /data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_SLOW_REQUEST_MS=3000
# true 时只写 stdout（容器/云平台收集），不再生成 logs/<component>.log；默认 false 保持原行为。
LOG_STDOUT_ONLY=false

# ===== 运维观测 =====
# Prometheus 采集令牌（仅 GET /api/v1/operations/metrics 使用）。
# 留空 = 采集关闭（返回 503）；它与管理员的 JWT 是两套凭据，JWT 不能代替。
# 生成示例: python -c "import secrets;print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
# 管理员摘要查询数据库的硬超时（秒）；超时明确返回 unavailable，不会阻塞或返回全零。
OPERATIONS_DB_TIMEOUT_SECONDS=2

# ===== CORS =====
# 生产用 Nginx 同源反代，浏览器不会跨域；这里保留本地开发地址即可。
# 若前端单独部署在别的域名，改成那个 origin（allow_credentials=True 时不能用 *）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
