# ===== 应用 =====
APP_NAME=Enterprise RAG Knowledge Base
# 接口文档开关：true 才注册 /docs、/redoc、/openapi.json。
# 生产保持 false——/openapi.json 会把全部接口与字段结构公开出去。
DEBUG=false
API_V1_PREFIX=/api/v1
# 本地开发保持 development；Compose 会强制覆盖为 production 并校验 JWT 密钥。
ENVIRONMENT=development
# 每个 API 进程的问答准入上限，超出立即返回 429，不挤占全部线程。
CHAT_MAX_PER_USER=2
CHAT_MAX_CONCURRENT=50
# 同一会话的持久化生成租约；后台定期续期，进程崩溃后到期允许新请求。
CHAT_LEASE_SECONDS=300
# 线程池槽位上限（默认 200）。问答是同步流式生成，每个 token 占一个槽位等云端返回；
# 调太小会在并发提问时把整站拖慢，调太大只会在极端并发下多占内存，一般不用改。
THREAD_POOL_SIZE=200

# ===== 数据库 (pgvector, 容器映射到宿主 9999) =====
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:9999/ragdb

# ===== 认证 =====
# 生产环境务必替换为随机长字符串: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 首次启动自动创建的管理员账号。
# ADMIN_PASSWORD 只在库里还没有这个用户时被读取一次：建号之后改这里不会改密码，
# 改密码请登录后走「个人中心」。管理员已存在时该值若与真实密码不符，
# 启动日志会告警提醒删除这一行——线上环境建议建号后就把密码从文件里删掉。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ===== 模型服务 =====
# EMBEDDING_PROVIDER / LLM_PROVIDER：ollama（本地） 或 cloud（任意 OpenAI 兼容服务）
# 两者互相独立，可以用 A 家的向量模型配 B 家的对话模型。
# API Key 只填在本地 .env，不要提交到仓库。
EMBEDDING_PROVIDER=cloud
LLM_PROVIDER=cloud

# --- 本地 Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- 向量服务（OpenAI 兼容）---
# 硅基流动 BAAI/bge-m3 当前免费，Key 在 https://cloud.siliconflow.cn/account/ak 获取
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=120
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MODEL=BAAI/bge-m3

# --- 对话服务（OpenAI 兼容）---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT=180
# 请求流末尾的实际 token 用量，用于用量/费用统计；不支持 stream_options 的网关可关闭。
LLM_STREAM_INCLUDE_USAGE=true
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
# DeepSeek 官方接口：none 关闭模型端思考；low / high / max 开启思考并设置强度。
# 主问答、普通对话、非流式调用及追问补全统一生效。修改后须重启 API。
# 切换到不支持 reasoning_effort 的兼容服务时留空，否则可能返回 400。
LLM_REASONING_EFFORT=none
# 必须不大于所接模型实际支持的窗口；总输入会预留最大输出和安全余量。
# 输入按 UTF-8 字节保守估算，不是模型 tokenizer 的精确 token 数。
# Ollama 同步使用此值作为 num_ctx，调大前检查内存/显存容量。
LLM_CONTEXT_WINDOW_TOKENS=32768
CONTEXT_TOKEN_SAFETY_MARGIN=512

# 云端 BAAI/bge-m3 与本地 bge-m3:latest 是同一份权重、同一向量空间，
# 两者的向量可以混用，切换服务商时不需要重建索引。

# ===== RAG 参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 检索条数默认值：问答页滑块的初值取自它；调用方未显式指定 top_k 时也用它。
# 改这里就对问答页生效，不需要改前端。
RETRIEVAL_TOP_K=6
# 0 保持原有召回范围；请基于问题集评测后再提高相似度阈值（0~1）。
RETRIEVAL_MIN_SIMILARITY=0
# 单份文档最多占几条检索结果：长文档的分块彼此相似，不封顶会挤掉其他来源
RETRIEVAL_MAX_PER_DOC=3
# 向量 + PostgreSQL 关键词候选，旧文档重新索引后填充关键词和结构位置。
HYBRID_RETRIEVAL_ENABLED=true
KEYWORD_CANDIDATES=60
# 仅扩展同章节/同工作表的相邻片段；0 关闭，最终仍受统一上下文预算限制。
RETRIEVAL_NEIGHBOR_CHUNKS=1
# 可选外部重排：默认不调用，不新增服务；需支持 POST /rerank。
RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=3
RERANK_MAX_CHARS=2000
MAX_UPLOAD_MB=50

# ===== 多轮上下文 =====
# 仅知识库模式中的常见指代/省略追问额外调用一次模型；独立问题、换话题和普通对话跳过。
# 单次总截止时间（秒），失败/超时回退原问题检索，不重试。
RETRIEVAL_REWRITE_ENABLED=true
RETRIEVAL_REWRITE_TIMEOUT=5
RETRIEVAL_REWRITE_MAX_TOKENS=256
RETRIEVAL_REWRITE_HISTORY_TURNS=3
RETRIEVAL_REWRITE_HISTORY_CHARS=3000
# 最多保留多少个完整 user + assistant 轮次；0 禁用历史。
HISTORY_MAX_TURNS=10
# 历史总字符上限，另受统一输入预算约束；最新一轮过长时成对截短。
HISTORY_MAX_CHARS=8000

# ===== 分片上传 / 断点续传 =====
# 生产走容器时由 compose 覆盖为 /data/uploads（绝对路径）。
# 注意 stored_path 会以相对路径存进数据库，API 与 worker 的工作目录和挂载必须一致。
UPLOAD_DIR=storage/uploads
UPLOAD_CHUNK_SIZE=4194304        # 4MB/片，由服务端下发
UPLOAD_SESSION_TTL_HOURS=24      # 未完成会话保留时长

# ===== 入库任务 =====
INGEST_BATCH_SIZE=8              # 每批向量化的分块数
INGEST_STALE_SECONDS=300         # 心跳超时判定
CHUNK_PERSIST_BATCH=500          # 分块落库批大小

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=logs                     # 生产由 compose 覆盖为 /data/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_SLOW_REQUEST_MS=3000

# ===== CORS =====
# 生产用 Nginx 同源反代，浏览器不会跨域；这里保留本地开发地址即可。
# 若前端单独部署在别的域名，改成那个 origin（allow_credentials=True 时不能用 *）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
