# staging 的 Compose / 维护配置模板。复制为同目录 .env 后填写真实凭据。
# 不新增共享公网反代；默认仅 127.0.0.1:18080，验收通过 SSH 隧道访问。

COMPOSE_PROJECT_NAME=ragkb-staging
RAGKB_DEPLOY_ENVIRONMENT=staging

# 不可变候选镜像标签；验收通过后生产可引用同一个产物。
BACKEND_IMAGE=rag-kb-backend:REPLACE_WITH_CANDIDATE_TAG
FRONTEND_IMAGE=rag-kb-web:REPLACE_WITH_CANDIDATE_TAG
COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml

DATA_DIR=/srv/ragkb-data/staging
BACKUP_DIR=${DATA_DIR}/backups

WEB_BIND_IP=127.0.0.1
WEB_PORT=18080
WEB_TLS_BIND_IP=127.0.0.1
WEB_TLS_PORT=18443
RAGKB_PROMETHEUS_PUBLISH=127.0.0.1
RAGKB_PROMETHEUS_PORT=19090
RAGKB_ALERTMANAGER_PUBLISH=127.0.0.1
RAGKB_ALERTMANAGER_PORT=19093
RAGKB_PROMETHEUS_RETENTION=7d

# staging 的凭据/数据库名与 production 完全独立。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb_staging

WORKER_STOP_TIMEOUT_SECONDS=180
API_STOP_TIMEOUT_SECONDS=30
KEEP_DAYS=3

# 4C8G 主机的 staging 低额基线；可选 worker 默认 profile 关闭，不自动启动。
DB_CPUS=0.75
DB_MEM_LIMIT=512M
API_CPUS=0.75
API_MEM_LIMIT=384M
WORKER_CPUS=0.50
WORKER_MEM_LIMIT=512M
WORKER_SUMMARY_CPUS=0.25
WORKER_SUMMARY_MEM_LIMIT=192M
WORKER_PROJECT_CPUS=0.25
WORKER_PROJECT_MEM_LIMIT=192M
WORKER_REGRESSION_CPUS=0.25
WORKER_REGRESSION_MEM_LIMIT=192M
WEB_CPUS=0.25
WEB_MEM_LIMIT=64M
RAGKB_LOG_MAX_SIZE=10m
RAGKB_LOG_MAX_FILE=3

RAGKB_REMOTE_BACKUP_ENABLED=false
RAGKB_TLS_MODE=http

# 可选监控/告警资源：入口按 COMPOSE_FILE 自动追加配额覆盖，不会自动启用服务。
RAGKB_PROMETHEUS_CPUS=0.25
RAGKB_PROMETHEUS_MEM_LIMIT=192M
RAGKB_ALERTMANAGER_CPUS=0.25
RAGKB_ALERTMANAGER_MEM_LIMIT=64M

# 可选覆盖示例：按需取消注释并填写，路径必须为本环境独立绝对路径。
# HTTPS 追加 docker-compose.https.yml；未填 ACME 时入口默认 ${DATA_DIR}/acme。
# RAGKB_SERVER_NAME=staging.example.com
# RAGKB_TLS_CERT_DIR=${DATA_DIR}/tls
# RAGKB_ACME_WEBROOT=${DATA_DIR}/acme
# RAGKB_TLS_MODE=https
# 监控追加 docker-compose.monitoring.yml，先准备仓库外 0600 token，再 render-prometheus。
# OUT_DIR=${DATA_DIR}/monitoring
# RAGKB_METRICS_TOKEN_FILE=${DATA_DIR}/secrets/metrics_token
# RAGKB_PROMETHEUS_CONFIG_DIR=${DATA_DIR}/monitoring/prometheus
# RAGKB_PROMETHEUS_SECRET_DIR=${DATA_DIR}/monitoring/secrets
# 告警还需 docker-compose.alerting.yml，先准备仓库外 0600 webhook，再 render-alertmanager。
# RAGKB_ALERTMANAGER_TARGET=alertmanager:9093
# RAGKB_ALERT_WEBHOOK_FILE=${DATA_DIR}/secrets/alert_webhook_url
# RAGKB_ALERTMANAGER_CONFIG_DIR=${DATA_DIR}/monitoring/alertmanager
# RAGKB_ALERTMANAGER_SECRET_DIR=${DATA_DIR}/monitoring/alertmanager/secrets
# 异地备份启用时设置独立的仓库外 0600 rclone 配置、crypt remote 和远端目录。
# RCLONE_CONFIG=${DATA_DIR}/secrets/rclone.conf
# RCLONE_REMOTE=staging_crypt:ragkb-staging
