# production 的 Compose / 维护配置模板。复制为同目录 .env 后填写真实凭据。
# 不要提交 .env / backend.env；两套环境使用独立凭据与不可变镜像标签。

COMPOSE_PROJECT_NAME=ragkb-prod
RAGKB_DEPLOY_ENVIRONMENT=production

# 不可变镜像标签；staging 验收通过后生产可引用同一个已验收产物。
BACKEND_IMAGE=rag-kb-backend:REPLACE_WITH_RELEASE_TAG
FRONTEND_IMAGE=rag-kb-web:REPLACE_WITH_RELEASE_TAG
COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml

# 宿主数据路径，production 与 staging 必须独立、互不嵌套。
DATA_DIR=/srv/ragkb-data/production
BACKUP_DIR=${DATA_DIR}/backups

# 生产默认公网 80；HTTPS/监控/告警覆盖由管理员在 COMPOSE_FILE 追加并分离端口。
WEB_BIND_IP=0.0.0.0
WEB_PORT=80
WEB_TLS_BIND_IP=0.0.0.0
WEB_TLS_PORT=443
RAGKB_PROMETHEUS_PUBLISH=127.0.0.1
RAGKB_PROMETHEUS_PORT=9090
RAGKB_ALERTMANAGER_PUBLISH=127.0.0.1
RAGKB_ALERTMANAGER_PORT=9093
RAGKB_PROMETHEUS_RETENTION=15d

# 数据库凭据：仅放在本环境 .env，权限 0600。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# 维护窗口：worker 停写预算（秒）。
WORKER_STOP_TIMEOUT_SECONDS=180
API_STOP_TIMEOUT_SECONDS=30
KEEP_DAYS=7

# 单容器运行时上限，不是整个环境总额，也不限制构建。生产按实际负载核算。
DB_CPUS=1.50
DB_MEM_LIMIT=1536M
API_CPUS=1.50
API_MEM_LIMIT=1024M
WORKER_CPUS=1.00
WORKER_MEM_LIMIT=768M
WORKER_SUMMARY_CPUS=0.50
WORKER_SUMMARY_MEM_LIMIT=256M
WORKER_PROJECT_CPUS=0.50
WORKER_PROJECT_MEM_LIMIT=256M
WORKER_REGRESSION_CPUS=0.50
WORKER_REGRESSION_MEM_LIMIT=256M
WEB_CPUS=0.50
WEB_MEM_LIMIT=128M
RAGKB_LOG_MAX_SIZE=20m
RAGKB_LOG_MAX_FILE=5

# 可选功能默认关闭；启用异地备份/HTTPS/监控时按部署手册设置独立路径与 secret。
RAGKB_REMOTE_BACKUP_ENABLED=false
RAGKB_TLS_MODE=http

# 可选监控/告警资源：入口按 COMPOSE_FILE 自动追加配额覆盖，不会自动启用服务。
RAGKB_PROMETHEUS_CPUS=0.50
RAGKB_PROMETHEUS_MEM_LIMIT=256M
RAGKB_ALERTMANAGER_CPUS=0.25
RAGKB_ALERTMANAGER_MEM_LIMIT=128M

# 可选覆盖示例：按需取消注释并填写，路径必须为本环境独立绝对路径。
# HTTPS 追加 docker-compose.https.yml；未填 ACME 时入口默认 ${DATA_DIR}/acme。
# RAGKB_SERVER_NAME=production.example.com
# RAGKB_TLS_CERT_DIR=${DATA_DIR}/tls
# RAGKB_ACME_WEBROOT=${DATA_DIR}/acme
# RAGKB_TLS_MODE=https
# 监控追加 docker-compose.monitoring.yml，先准备仓库外 0600 token，再 render-prometheus。
# OUT_DIR=${DATA_DIR}/monitoring
# RAGKB_METRICS_TOKEN_FILE=${DATA_DIR}/secrets/metrics_token
# RAGKB_PROMETHEUS_CONFIG_DIR=${DATA_DIR}/monitoring/prometheus
# RAGKB_PROMETHEUS_SECRET_DIR=${DATA_DIR}/monitoring/secrets
# 告警还需 docker-compose.alerting.yml，先准备仓库外 0600 webhook，再 render-alertmanager。
# RAGKB_ALERTMANAGER_TARGET=alertmanager:9093
# RAGKB_ALERT_WEBHOOK_FILE=${DATA_DIR}/secrets/alert_webhook_url
# RAGKB_ALERTMANAGER_CONFIG_DIR=${DATA_DIR}/monitoring/alertmanager
# RAGKB_ALERTMANAGER_SECRET_DIR=${DATA_DIR}/monitoring/alertmanager/secrets
# 异地备份启用时设置独立的仓库外 0600 rclone 配置、crypt remote 和远端目录。
# RCLONE_CONFIG=${DATA_DIR}/secrets/rclone.conf
# RCLONE_REMOTE=production_crypt:ragkb-production
