# ===== docker compose 变量（复制为 .env 后修改）=====
# 这份文件只给 compose 用；后端自己的配置在 backend/.env。

# 数据目录：建议指向独立数据盘，例如 /data/rag-kb
# 机器若为竞价实例（可能被回收），换机器时把整个目录拷走即可恢复
DATA_DIR=./data

# 对外访问端口（Nginx）
WEB_PORT=80

# ===== 数据库 =====
POSTGRES_USER=postgres
# 生产务必改掉；只含字母数字，避免连接串里的特殊字符要转义
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ===== 应用（同时用于 backend/.env）=====
# 用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=change-me-to-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login

# 模型服务
EMBEDDING_PROVIDER=cloud
LLM_PROVIDER=cloud
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
LLM_BASE_URL=https://www.sheapi.top/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
