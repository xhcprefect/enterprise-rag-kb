# ===== docker compose 变量（复制为 .env 后修改）=====
# 这份文件只给 compose 用；后端自己的配置在 backend/.env。
#
# 所有“外部依赖”开关默认关闭：HTTPS、异地备份、监控采集都必须在明确配置后
# 才启用。未配置时 Compose 直接报错（不会用空值静默启动）。

# 数据目录：建议指向独立数据盘，例如 /data/rag-kb
# 机器若为竞价实例（可能被回收），换机器时把整个目录拷走即可恢复。
# 目录结构（备份/恢复脚本按这些子目录打包，见 deploy/backup.sh）：
#   pgdata/      PostgreSQL 数据
#   uploads/     上传文档与分片
#   projects/    项目源码 blob（内容寻址；API 与 project worker 共用）
#   logs/        API/worker 日志
#   backups/     本地备份产物
DATA_DIR=./data

# 对外访问端口（Nginx）
WEB_PORT=80

# ===== 独立角色 worker（默认不启动）=====
# Compose 用 profile 控制角色：只有显式 --profile 才启动对应容器。
#   summary：CHAT_MEMORY_ENABLED=true 时启动，消费对话摘要任务
#            docker compose --profile summary up -d worker-summary
#   project：配置了 backend/.env 的 PROJECT_ALLOWED_ROOTS 后启动，消费项目同步任务
#            docker compose --profile project up -d worker-project
# 两者都不随 `docker compose up -d` 默认启动；未启用相应功能时运行它们只会空转。
#
# 可选：把宿主机项目目录以**只读**方式绑给 worker-project。默认关闭，脚本绝不
# 自动挂载任何宿主机路径。启用时必须同时：
#   1. 在 backend/.env 的 PROJECT_ALLOWED_ROOTS 里写容器内路径（例如 /srv/projects/lib）；
#   2. 在 docker-compose.yml 的 worker-project.volumes 取消注释并保持宿主机/容器路径一致。
# PROJECT_ROOT_HOST=/srv/projects

# ===== 数据库 =====
POSTGRES_USER=postgres
# 生产务必改掉；只含字母数字，避免连接串里的特殊字符要转义
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ===== 应用（同时用于 backend/.env）=====
# 用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=change-me-to-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login

# 模型服务
EMBEDDING_PROVIDER=cloud
LLM_PROVIDER=cloud
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
LLM_BASE_URL=https://www.sheapi.top/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# ===== 维护窗口：worker 停写预算 =====
# 备份/恢复前 `docker compose stop` 的等待上限（秒），同一个值同时用于
# docker-compose.yml 的 stop_grace_period 与 deploy/common.sh 的 stop 超时。
# 这是“等待上限”，不是“每个任务都能在该时间内优雅结束”的承诺：到期 Docker
# 会强杀，未完成文档靠心跳/租约回到 pending 续传。
WORKER_STOP_TIMEOUT_SECONDS=180

# ===== 后端新功能默认关闭（随 Compose 透传给 backend/.env）=====
# Compose 默认保持关闭，与旧行为一致：
#   CHAT_MEMORY_ENABLED=false          # 普通对话摘要压缩，关闭=现有窗口裁剪
#   PROJECT_ALLOWED_ROOTS={}           # 本地项目索引授权根目录，空=禁止创建源
# 生产如需开启，请直接编辑 backend/.env（见其“普通对话摘要压缩”/“本地项目索引”段），
# 或在 compose 环境里显式覆盖；本文件不写入任何真实授权目录。

# ===== 可选：HTTPS（默认关闭）=====
# 启用方式：docker compose -f docker-compose.yml -f docker-compose.https.yml up -d
# 只有在下面全部配置好、且证书由可信 CA 签发后才称得上“可对外提供服务”。
#
# http（默认，纯 HTTP 开发/内网）或 https
RAGKB_TLS_MODE=http
# 固定对外域名（小写 DNS）。不能写通配符/IP；80 端口的 301 目标只用它，
# 绝不反射请求里的 Host。
RAGKB_SERVER_NAME=
# 证书目录（宿主机绝对路径，位于仓库外，只读挂载）：需含 fullchain.pem 与
# privkey.pem。不要把证书/私钥提交进仓库。
RAGKB_TLS_CERT_DIR=
# 证书/私钥在容器内的文件名，与 RAGKB_TLS_CERT_DIR 配合使用
RAGKB_TLS_CERT=/etc/nginx/certs/fullchain.pem
RAGKB_TLS_KEY=/etc/nginx/certs/privkey.pem
# HSTS max-age（秒）。首次上线建议先用较小值（如 300）验证。
RAGKB_HSTS_MAX_AGE=31536000
# HTTPS 端口
WEB_TLS_PORT=443
# ACME webroot（可选，用于 certbot 续期）。不设置则只提示，不影响已有证书启动。
RAGKB_ACME_WEBROOT=./data/acme
# 可信反代地址（逗号分隔的 IP/CIDR）。默认空 = 不信任任何客户端自带的
# X-Forwarded-For。仅在确实有前置负载均衡器时填写其准确地址。
RAGKB_TRUSTED_PROXIES=

# ===== 可选：异地备份（默认关闭）=====
# 启用前置条件（缺一不可，脚本会逐项校验并在不满足时拒绝上传）：
#   1. RCLONE_CONFIG 指向**仓库外**的 rclone 配置文件，权限 0600/0400；
#   2. RCLONE_REMOTE 指向该配置里的 **crypt** remote（明文远端会被拒绝）；
#   3. 本地成对产物与清单校验通过（失败则不上传）。
# 行为：数据文件先传并逐字节校验，manifest 最后发布；不 sync、不 delete，
# 覆盖不了其他日期/其他次导出的备份；远端失败时本地备份与退出码都保留现场。
RAGKB_REMOTE_BACKUP_ENABLED=false
RCLONE_CONFIG=
# 形如 crypt_remote:path/to/backups
RCLONE_REMOTE=

# ===== 可选：监控（默认关闭）=====
# backend/.env 里设置 METRICS_TOKEN 后，/api/v1/operations/metrics 才可用；
# 未设置时该接口返回 503（采集关闭）。Prometheus 侧用同值的仓库外 secret 文件。
#
# 仓库外令牌文件（宿主机保持 0600；render-prometheus.sh 会复制出容器可读副本）
RAGKB_METRICS_TOKEN_FILE=
# 渲染后的 Prometheus 配置目录（render-prometheus.sh 的 $OUT_DIR/prometheus）
RAGKB_PROMETHEUS_CONFIG_DIR=
# 容器可读令牌副本目录（render-prometheus.sh 的 $OUT_DIR/secrets，目录 0755/文件 0444）
# 启用 docker-compose.monitoring.yml 时必填，否则 compose 直接拒绝启动。
RAGKB_PROMETHEUS_SECRET_DIR=
# 保留天数
RAGKB_PROMETHEUS_RETENTION=15d
# 默认只绑定回环；不要改成 0.0.0.0 直接暴露到公网
RAGKB_PROMETHEUS_PUBLISH=127.0.0.1
RAGKB_PROMETHEUS_PORT=9090

# 采集参数
RAGKB_SCRAPE_INTERVAL=30s
RAGKB_SCRAPE_TIMEOUT=10s
RAGKB_INSTANCE_LABEL=ragkb-single-api

# 告警阈值（按业务调整；规则文件里未覆盖的项用 render-prometheus.sh 的默认值）
RAGKB_ALERT_FIRST_TOKEN_QUANTILE=0.95
RAGKB_ALERT_FIRST_TOKEN_SECONDS=20
RAGKB_ALERT_STAGE_SECONDS=30
RAGKB_ALERT_FAILURE_RATIO=0.2
RAGKB_ALERT_FAILURE_MIN_COUNT=5
RAGKB_ALERT_IN_FLIGHT_MAX=20
RAGKB_ALERT_HTTP_QUANTILE=0.95
RAGKB_ALERT_HTTP_SECONDS=5
RAGKB_ALERT_HTTP_5XX_RATIO=0.05
RAGKB_ALERT_HTTP_5XX_MIN_COUNT=5
RAGKB_ALERT_HTTP_IN_FLIGHT_MAX=100
RAGKB_ALERT_QUEUE_BACKLOG=50
RAGKB_ALERT_PENDING_AGE_SECONDS=1800
RAGKB_ALERT_POOL_SATURATION=0.9
